rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /fichas/{fichaId} {
      // Dono: leitura e escrita. Mestre (e-mail em sharedWithEmails): somente leitura.
      allow read: if request.auth != null && (
        resource.data.ownerId == request.auth.uid ||
        (request.auth.token.email != null &&
         request.auth.token.email.lower() in resource.data.sharedWithEmails)
      );
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update: if request.auth != null && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    // Salas de mesa ao vivo (Feed de Dados e Fila de Iniciativa do grupo)
    match /mesas/{mesaId} {
      allow read, write: if request.auth != null;
    }

    // Perfis públicos de jogadores e lista de amigos
    match /perfis/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Solicitações e conexões mútuas de amizade
    match /amizades/{amizadeId} {
      allow read: if request.auth != null && (resource == null || request.auth.uid in resource.data.uids);
      allow create: if request.auth != null
        && request.resource.data.fromUid == request.auth.uid
        && request.auth.uid in request.resource.data.uids;
      allow update, delete: if request.auth != null && request.auth.uid in resource.data.uids;
    }
  }
}
