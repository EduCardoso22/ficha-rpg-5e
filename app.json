{
  "expo": {
    "name": "Fichas D&D",
    "slug": "ficha-rpg-5e",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ficharpg5e",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1A1A1F",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.hyriuky.ficharpg5e"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1A1A1F",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 110
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "bd767f84-5600-46e4-afce-6a9dec73c86f"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/bd767f84-5600-46e4-afce-6a9dec73c86f"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
